# LLM provider: paratera, fancybag or xty. Fill the selected provider API key before switching.
SOCAGENT_LLM_PROVIDER=paratera

# Fancybag (OpenAI-compatible API)
FANCYBAG_API_KEY=
FANCYBAG_BASE_URL=https://sub.fancybag.cn/v1
FANCYBAG_MODEL=deepseek-v4.1-flash
FANCYBAG_REASONING_EFFORT=low
FANCYBAG_THINKING_ENABLED=false
FANCYBAG_REQUEST_TIMEOUT_SECONDS=120
FANCYBAG_MAX_RETRIES=0
# Optional: set only if an embedding model is available on your account.
FANCYBAG_EMBEDDING_MODEL=

PARATERA_API_KEY=your_api_key_here
PARATERA_BASE_URL=https://ai.paratera.com/v1/
PARATERA_MODEL=DeepSeek-V4.1-Flash
PARATERA_EMBEDDING_MODEL=GLM-Embedding-3
PARATERA_REASONING_EFFORT=low
PARATERA_THINKING_ENABLED=false
PARATERA_REQUEST_TIMEOUT_SECONDS=120
PARATERA_MAX_RETRIES=0
SOCAGENT_DB_PATH=runtime/socagent.db
SOCAGENT_POLL_INTERVAL=5
SOCAGENT_WEB_HOST=127.0.0.1
SOCAGENT_WEB_PORT=5008
# Optional default LTM profile. Event context.memory_profile takes precedence.
SOCAGENT_MEMORY_PROFILE=
# auto uses Neo4j when NEO4J_PASSWORD is available, otherwise JSON snapshots.
SOCAGENT_LTM_BACKEND=auto
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-password
NEO4J_DATABASE=neo4j
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=SocAgentB0ts1Pass
SPLUNK_VERIFY_TLS=false
SPLUNK_DEFAULT_DATASET=botsv1
SPLUNK_BOTSV1_BASE_URL=https://127.0.0.1:8089
SPLUNK_BOTSV1_INDEX=botsv1
SPLUNK_BOTSV2_BASE_URL=http://127.0.0.1:8020
SPLUNK_BOTSV2_INDEX=botsv2
SPLUNK_BOTSV3_BASE_URL=http://127.0.0.1:8030
SPLUNK_BOTSV3_INDEX=botsv3
SOCAGENT_BENCHMARK_WORKERS=3
PARATERA_RPM_LIMIT=2500
PARATERA_TPM_LIMIT=5000000
PARATERA_RATE_UTILIZATION=0.8
PARATERA_OUTPUT_TOKEN_RESERVE=16384

# Official ExCyTIn judge (external_agents.runner / batch).
# Defaults to the investigation model, URL and key (PARATERA settings).
# Optional overrides only; no separate judge configuration is needed.
# EXCYTIN_JUDGE_MODEL=DeepSeek-V4.1-Flash
# EXCYTIN_JUDGE_BASE_URL=https://your-provider.example/v1
# EXCYTIN_JUDGE_API_KEY=your_judge_key
# EXCYTIN_JUDGE_TIMEOUT=180

# XTY (OpenAI-compatible API)
XTY_API_KEY=
XTY_BASE_URL=https://api.xty.app/v1
XTY_MODEL=deepseek-v4.1-flash
XTY_REASONING_EFFORT=low
XTY_THINKING_ENABLED=false
XTY_REQUEST_TIMEOUT_SECONDS=120
XTY_MAX_RETRIES=0
# Optional: set only if an embedding model is available on your account.
XTY_EMBEDDING_MODEL=
