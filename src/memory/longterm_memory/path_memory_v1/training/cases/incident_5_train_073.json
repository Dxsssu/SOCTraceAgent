    "116": {
      "type": "alert",
      "name": "File backups were deleted",
      "description": "All file snapshots and shadow copies have been deleted via WMI or VSSAdmin which is common during Ransomware infection.\n\nFor more information, read the Activity Profile: Iranian MOIS operators opportunistically deploy limited-impact wiper in response to Israel-Hamas war Threat Analytics report: https://security.microsoft.com/threatanalytics3/c6674205-df28-453a-9e42-0010b7979bdd/overview?tid4b2462a4-bbee-495a-a0e1-f23ae524cc9c"
