{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failure Recovery Episodic Memory v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "generated_at",
    "generation_policy",
    "environment_id",
    "semantic_catalog",
    "catalog",
    "entries"
  ],
  "properties": {
    "format_version": {
      "const": "2.0"
    },
    "generated_at": {
      "type": "string"
    },
    "generation_policy": {
      "type": "object",
      "required": [
        "source_split",
        "error_only",
        "contains_raw_observations",
        "contains_answers",
        "contains_test_data"
      ],
      "properties": {
        "source_split": {
          "const": "train"
        },
        "error_only": {
          "const": true
        },
        "contains_raw_observations": {
          "const": false
        },
        "contains_answers": {
          "const": false
        },
        "contains_test_data": {
          "const": false
        }
      }
    },
    "environment_id": {
      "type": "string"
    },
    "semantic_catalog": {
      "type": "object",
      "required": [
        "catalog_id",
        "schema_hash"
      ]
    },
    "catalog": {
      "type": "object",
      "required": [
        "episodic_catalog_id",
        "source_sha256",
        "entry_count",
        "error_attempt_count",
        "supported_error_count",
        "excluded_error_count"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "background",
          "error",
          "repair"
        ],
        "properties": {
          "background": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "string",
            "minLength": 1
          },
          "repair": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
