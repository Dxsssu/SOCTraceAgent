{
  "type": "object",
  "properties": {
    "format_version": {
      "const": "5.0"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "generation_policy": {
      "type": "object",
      "required": [
        "source_split",
        "contains_sql",
        "contains_log_values",
        "contains_answers",
        "contains_test_data",
        "method",
        "min_episodes",
        "min_incidents_active"
      ],
      "properties": {
        "source_split": {
          "const": "train"
        },
        "contains_sql": {
          "const": true
        },
        "contains_log_values": {
          "const": false
        },
        "contains_answers": {
          "const": false
        },
        "contains_test_data": {
          "const": false
        },
        "method": {
          "const": "parameterized_successful_query_patterns"
        },
        "min_episodes": {
          "const": 2
        },
        "min_incidents_active": {
          "const": 2
        }
      },
      "additionalProperties": false
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_catalog": {
      "type": "object",
      "properties": {
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "catalog_id",
        "schema_hash"
      ],
      "additionalProperties": false
    },
    "episodic_catalog": {
      "type": "object",
      "properties": {
        "episodic_catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "episodic_catalog_id",
        "source_sha256"
      ],
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "properties": {
        "procedural_catalog_id": {
          "const": "excytin-query-templates-v5"
        },
        "procedure_count": {
          "type": "integer"
        },
        "active_count": {
          "type": "integer"
        },
        "training_episode_count": {
          "type": "integer"
        },
        "training_attempt_count": {
          "type": "integer"
        },
        "semantic_snapshot_sha256": {
          "type": "string",
          "minLength": 1
        },
        "episodic_snapshot_sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "procedural_catalog_id",
        "procedure_count",
        "active_count",
        "training_episode_count",
        "training_attempt_count",
        "semantic_snapshot_sha256",
        "episodic_snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "procedures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "purpose",
          "inputs",
          "sql_template",
          "returns",
          "semantic_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pm_[a-f0-9]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "candidate"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 4,
            "additionalProperties": {
              "type": "object",
              "required": [
                "field",
                "type",
                "description",
                "operator"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "string[]",
                    "number[]"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "sql_template": {
            "type": "string",
            "minLength": 1
          },
          "returns": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 12,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "semantic_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "table",
                "fields"
              ],
              "additionalProperties": false,
              "properties": {
                "table": {
                  "type": "string",
                  "minLength": 1
                },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "generated_at",
    "generation_policy",
    "environment_id",
    "semantic_catalog",
    "episodic_catalog",
    "catalog",
    "procedures"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
